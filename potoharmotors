        // modern click handler with smooth redirection
        tiles.forEach(tile => {
            tile.addEventListener('click', (e) => {
                e.stopPropagation();
                let link = tile.getAttribute('data-link');
                if (link && link !== 'google_link_placeholder' && link !== 'youtube_link_placeholder' && 
                    link !== 'facebook_link_placeholder' && link !== 'instagram_link_placeholder' && 
                    link !== 'tiktok_link_placeholder') {
                    window.open(link, '_blank');
                } else {
                    console.warn('Review link missing for:', tile.innerText);
                    alert('✅ All review links are pre‑configured! If you see this, please double‑check the script.');
